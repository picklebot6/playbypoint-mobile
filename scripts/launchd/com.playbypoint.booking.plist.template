<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__USER_HOME__</string>
		<key>TZ</key>
		<string>America/Los_Angeles</string>
	</dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>com.playbypoint.booking</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__PROJECT_DIR__/scripts/playbypoint-launchd-runner.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__PROJECT_DIR__/logs/playbypoint-launchd.stderr.log</string>
	<key>StandardOutPath</key>
	<string>__PROJECT_DIR__/logs/playbypoint-launchd.stdout.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>56</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>__PROJECT_DIR__</string>
</dict>
</plist>
